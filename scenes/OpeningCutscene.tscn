[sub_resource type="Resource" id="Line1"]
script = ExtResource("3")
text = "Something had begun stirring beyond the old forest.\nRed's brother went to find its source."

[sub_resource type="Resource" id="Line2"]
script = ExtResource("3")
text = "There was one person Red trusted more than anyone else — her brother."

[sub_resource type="Resource" id="Line3a"]
script = ExtResource("3")
speaker = "Red"
text = "Then I’m coming with you."
hold_seconds = 1.4

[sub_resource type="Resource" id="Line3b"]
script = ExtResource("3")
speaker = "Brother"
text = "No."
hold_seconds = 0.9

[sub_resource type="Resource" id="Line4a"]
script = ExtResource("3")
speaker = "Red"
text = "You always say that."

[sub_resource type="Resource" id="Line4b"]
script = ExtResource("3")
speaker = "Brother"
text = "And you never listen."

[sub_resource type="Resource" id="Line4c"]
script = ExtResource("3")
speaker = "Brother"
text = "I’ve still got this, don’t I?"
hold_seconds = 1.9

[sub_resource type="Resource" id="Line4d"]
script = ExtResource("3")
speaker = "Red"
text = "…You kept it?"
hold_seconds = 1.5

[sub_resource type="Resource" id="Line4e"]
script = ExtResource("3")
speaker = "Brother"
text = "Of course."
hold_seconds = 1.0

[sub_resource type="Resource" id="Line5a"]
script = ExtResource("3")
speaker = "Brother"
text = "Keep the light on for me."

[sub_resource type="Resource" id="Line5b"]
script = ExtResource("3")
speaker = "Red"
text = "Come back before it burns out."
hold_seconds = 1.8

[sub_resource type="Resource" id="Line5c"]
script = ExtResource("3")
speaker = "Brother"
text = "Deal."
hold_seconds = 0.9

[sub_resource type="Resource" id="Line6"]
script = ExtResource("3")
text = "But night deepened...\nand he did not return."

[sub_resource type="Resource" id="Line7"]
script = ExtResource("3")
speaker = "Red"
text = "...You promised."

[sub_resource type="Resource" id="Line7b"]
script = ExtResource("3")
speaker = "Red"
text = "So I'm coming to find you."
hold_seconds = 1.9

[sub_resource type="Resource" id="Line8"]
script = ExtResource("3")
text = ""

